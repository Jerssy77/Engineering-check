DATABASE_URL="postgresql://postgres:postgres@localhost:5432/property_review?schema=public"
REDIS_URL="redis://localhost:6379"
WEB_HOST="0.0.0.0"
WEB_PORT="3000"
API_HOST="0.0.0.0"
API_PORT="3001"
# Tailscale/VPN 共享时建议改成这台服务器电脑的 Tailscale IPv4 地址
NEXT_PUBLIC_API_BASE_URL="http://100.x.x.x:3001"
AI_PROVIDER="auto"
AI_API_BASE_URL="https://api.openai.com/v1"
AI_API_PATH="/chat/completions"
AI_API_KEY=""
AI_MODEL_NAME="gpt-5.6-terra"
# auto：OpenAI 官方端点使用严格 JSON Schema，其他兼容网关保留 JSON mode；也可显式设为 strict 或 json_object。
AI_STRUCTURED_OUTPUTS_MODE="auto"
AI_CONFIG_MASTER_KEY="replace-with-a-long-random-secret-before-storing-api-keys"
AI_API_TIMEOUT_MS="1800000"
# 可选：测试机需要代理访问模型服务时配置；生产环境通常留空。
AI_HTTP_PROXY=""
AI_ALLOW_DEMO_FALLBACK="false"
# 第二阶段生产底座完成前，这两个开关必须保持 false。
PRODUCTION_FOUNDATION_READY="false"
GUIDED_FORMAL_AUTO_APPROVAL="false"
APP_TIMEZONE="Asia/Shanghai"
APP_DATA_FILE="./runtime-data/app-state.json"
APP_UPLOAD_DIR="./runtime-data/uploads"
ATTACHMENT_MAX_SIZE_BYTES="524288"
NON_PHOTO_ATTACHMENTS_MAX_TOTAL_BYTES="2097152"
PDF_FONT_PATH="./apps/api/assets/fonts/NotoSansSC-Regular.otf"
